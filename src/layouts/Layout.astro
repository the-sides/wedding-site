---
import "@/styles/global.css";
import CookieBanner from "@/components/CookieBanner.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Jacob & Vicki",
  description = "Wedding details for Jacob and Vicki.",
  image = "/PXL_20251227_010505912.jpg",
} = Astro.props;

const imageUrl = Astro.site ? new URL(image, Astro.site).href : image;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="generator" content={Astro.generator} />

    <!--
      Publishes the cookie banner's answer as an attribute so CSS can branch on
      it. Inline and in the head on purpose: this has to run before first paint,
      or Jacob's guests would get a frame of the still hero before it starts
      moving. `is:inline` keeps Astro from bundling it into a deferred module,
      which would defeat the whole point.
    -->
    <script is:inline>
      try {
        const allegiance = localStorage.getItem("wedding:allegiance");
        if (allegiance)
          document.documentElement.dataset.allegiance = allegiance;
      } catch {
        /* Private mode. Nobody is here for Jacob. */
      }
    </script>
  </head>
  <body class="dark">
    <slot />

    <!-- Site-wide, and last in the body so it layers over every page. -->
    <CookieBanner />
  </body>
</html>
