---
// A placeholder section: the day's timing isn't settled yet, but the heading
// reserves the slot so guests know it's coming rather than missing. When the
// real schedule lands, replace the body below and keep the header as-is.
---

<section
  class="bg-[#f4eadc] px-5 py-16 sm:px-8 lg:px-10"
  aria-label="Wedding schedule"
>
  <div class="mx-auto max-w-6xl">
    <header class="border-b border-[#221812]/15 pb-5">
      <p
        class="font-['Avenir_Next','Gill_Sans',sans-serif] text-xs uppercase tracking-[0.26em] text-[#9b6e38]"
      >
        The day
      </p>
      <h2
        class="mt-2 font-['Bodoni_72','Didot','Baskerville',serif] text-5xl leading-none text-[#221812] sm:text-6xl"
      >
        Schedule
      </h2>
    </header>

    <div
      class="mt-8 border border-[#221812]/15 bg-[#fff8ee]/58 px-6 py-12 text-center shadow-[0_18px_60px_rgba(54,38,22,0.08)] sm:px-8 sm:py-16"
    >
      <p
        class="font-['Bodoni_72','Didot','Baskerville',serif] text-4xl leading-none text-[#221812] sm:text-5xl"
      >
        Coming soon
      </p>
      <p
        class="mx-auto mt-4 max-w-md font-['Avenir_Next','Gill_Sans',sans-serif] text-sm leading-6 text-[#6f5a45]"
      >
        We're still working out the timing for the day. Check back here for
        ceremony and reception details.
      </p>
    </div>
  </div>
</section>
