---
import type { Post } from "@/lib/notion";
import PostBody from "@/components/PostBody.astro";

interface Props {
  posts: Array<Post>;
}

const { posts } = Astro.props;

function formatDate(value: string | null) {
  if (!value) return null;

  return new Intl.DateTimeFormat("en", {
    dateStyle: "medium",
    timeZone: "UTC",
  }).format(new Date(value));
}
---

{
  posts.length > 0 && (
    <section class="bg-[#f4eadc] px-5 py-16 sm:px-8 lg:px-10">
      <div class="mx-auto max-w-6xl">
        <div class="mb-8 flex items-end justify-between gap-6 border-b border-[#221812]/15 pb-5">
          <div>
            <p class="font-['Avenir_Next','Gill_Sans',sans-serif] text-xs uppercase tracking-[0.26em] text-[#9b6e38]">
              Notes
            </p>
            <h2 class="mt-2 font-['Bodoni_72','Didot','Baskerville',serif] text-5xl leading-none text-[#221812] sm:text-6xl">
              Updates
            </h2>
          </div>
          {/* <span class="font-['Avenir_Next','Gill_Sans',sans-serif] text-xs uppercase tracking-[0.22em] text-[#6f5a45]">
            Jacob &amp; Vicki
          </span> */}
        </div>

        <div class="grid gap-6 lg:grid-cols-2">
          {posts.map((post) => (
            <article class="border border-[#221812]/15 bg-[#fff8ee]/58 p-5 shadow-[0_18px_60px_rgba(54,38,22,0.08)] sm:p-6">
              <div class="flex items-start justify-between gap-5">
                <h3 class="font-['Bodoni_72','Didot','Baskerville',serif] text-4xl leading-none text-[#221812]">
                  {post.title}
                </h3>
                {formatDate(post.date) && (
                  <time class="shrink-0 pt-1 font-['Avenir_Next','Gill_Sans',sans-serif] text-xs uppercase tracking-[0.18em] text-[#9b6e38]">
                    {formatDate(post.date)}
                  </time>
                )}
              </div>
              <PostBody blocks={post.blocks} />
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}
