---
import { navLinks } from "@/lib/nav";

// The home page's only job below the hero: send guests to one of the four
// pages. Four buttons across on anything wider than a phone, stacked full
// width below that — nothing but the page names.
---

<nav
  id="pages"
  class="bg-[#f4eadc] px-5 py-16 sm:px-8 lg:px-10"
  aria-label="Wedding pages"
>
  <div class="mx-auto max-w-6xl">
    <ul class="grid gap-4 sm:grid-cols-4">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="flex items-center justify-center border border-[#221812]/15 bg-[#fff8ee]/58 px-4 py-6 text-center font-['Bodoni_72','Didot','Baskerville',serif] text-3xl leading-none text-[#221812] transition hover:border-[#9b6e38]/60 hover:bg-[#fff8ee] hover:text-[#9b6e38] sm:py-8 lg:text-4xl"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>
