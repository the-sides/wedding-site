---
import { navLinks } from "@/lib/nav";

// The home page's only job below the hero: send guests to one of the four
// pages. Each card is a single <a> so the whole tile is the hit target, which
// matters more on a phone than the arrow glyph does.
---

<nav
  id="pages"
  class="bg-[#f4eadc] px-5 py-16 sm:px-8 lg:px-10"
  aria-label="Wedding pages"
>
  <div class="mx-auto max-w-6xl">
    <ul class="grid gap-6 sm:grid-cols-2">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="group flex h-full flex-col justify-between gap-6 border border-[#221812]/15 bg-[#fff8ee]/58 p-6 shadow-[0_18px_60px_rgba(54,38,22,0.08)] transition hover:border-[#9b6e38]/60 hover:bg-[#fff8ee] sm:p-8"
            >
              <div>
                <p class="font-['Avenir_Next','Gill_Sans',sans-serif] text-xs uppercase tracking-[0.26em] text-[#9b6e38]">
                  {link.eyebrow}
                </p>
                <h2 class="mt-2 font-['Bodoni_72','Didot','Baskerville',serif] text-5xl leading-none text-[#221812] sm:text-6xl">
                  {link.label}
                </h2>
              </div>

              <span
                class="font-['Avenir_Next','Gill_Sans',sans-serif] text-xs uppercase tracking-[0.22em] text-[#6f5a45] transition group-hover:text-[#9b6e38]"
                aria-hidden="true"
              >
                View
                <span class="ml-2 inline-block transition group-hover:translate-x-1">
                  &rarr;
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>
