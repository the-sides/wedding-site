---
import { RSVP_CLOSED_TITLE, RSVP_CLOSED_DETAILS } from "@/lib/rsvp-status";
---

<section class="cloth-notice" aria-labelledby="notice-heading">
  <div class="cloth-stage" data-cloth-stage>
    <div class="cloth-fallback">
      <h1 id="notice-heading">{RSVP_CLOSED_TITLE}</h1>
      <hr aria-hidden="true" />
      <p>{RSVP_CLOSED_DETAILS}</p>
    </div>
    <div class="cloth-canvas" data-cloth-canvas aria-hidden="true"></div>
  </div>
</section>

<script>
  import { mountClothNotice } from "@/lib/cloth/notice";
  const stage = document.querySelector<HTMLElement>("[data-cloth-stage]");
  if (stage)
    mountClothNotice(stage).catch((error) => {
      // The HTML notice stays visible if WebGL is unavailable.
      console.warn("Cloth animation unavailable:", error);
    });
</script>

<style>
  .cloth-notice {
    max-width: 1080px;
    margin: 0 auto;
    padding: 30px 24px;
  }
  .cloth-stage {
    position: relative;
    height: clamp(440px, 68svh, 680px);
    margin: 0 -20px;
  }
  .cloth-canvas {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .cloth-canvas :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
  }
  .cloth-fallback {
    position: absolute;
    inset: 7% 12% 9%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 32px;
    text-align: center;
    color: #48201e;
    background: #fff8e9;
    box-shadow: 0 20px 35px #4d352318;
  }
  .cloth-fallback h1 {
    max-width: 510px;
    font:
      48px/1.08 "Baskerville",
      Georgia,
      serif;
  }
  .cloth-fallback hr {
    width: 48px;
    margin: 28px 0;
    border: 0;
    border-top: 1px solid #8f5147;
  }
  .cloth-fallback p {
    max-width: 340px;
    font:
      19px/1.6 "Baskerville",
      Georgia,
      serif;
  }
  .cloth-stage.is-ready .cloth-canvas {
    opacity: 1;
  }
  .cloth-stage.is-ready .cloth-fallback {
    clip-path: inset(50%);
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
  }
  @media (max-width: 600px) {
    .cloth-notice {
      padding: 24px 20px;
    }
    .cloth-stage {
      height: 430px;
    }
    .cloth-fallback {
      inset: 8% 7%;
      padding: 28px;
    }
    .cloth-fallback h1 {
      font-size: 34px;
    }
  }
</style>
