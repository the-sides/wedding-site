---
import {
  RSVP_CLOSED_TITLE,
  RSVP_CLOSED_DETAILS,
  RSVP_CLOSED_ASIDE,
  NOTICE_SUBSCRIBE_LABEL,
  NOTICE_SUBSCRIBE_PLACEHOLDER,
  NOTICE_SUBSCRIBE_BUTTON,
  NOTICE_SUBSCRIBE_HINT,
} from "@/lib/rsvp-status";
---

<section class="cloth-notice" aria-labelledby="notice-heading">
  <div class="cloth-stage" data-cloth-stage>
    <div class="cloth-fallback">
      <div class="cloth-copy">
        <h1 id="notice-heading">{RSVP_CLOSED_TITLE}</h1>
        <hr aria-hidden="true" />
        <p>{RSVP_CLOSED_DETAILS}</p>
        <p class="aside">{RSVP_CLOSED_ASIDE}</p>
      </div>
      <!--
        A real form, not a drawing of one. While the cloth runs it turns
        invisible and rides over the field printed into the fabric, so the
        browser keeps doing focus, keyboards, and autofill. See cloth/field.ts.
      -->
      <form
        class="cloth-field"
        data-subscribe
        action="/api/subscribe"
        method="post"
        novalidate
      >
        <label for="notice-email">{NOTICE_SUBSCRIBE_LABEL}</label>
        <input
          id="notice-email"
          type="email"
          name="email"
          autocomplete="email"
          inputmode="email"
          placeholder={NOTICE_SUBSCRIBE_PLACEHOLDER}
          required
        />
        <button type="submit">{NOTICE_SUBSCRIBE_BUTTON}</button>
        <input
          class="trap"
          name="website"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />
        <p data-subscribe-status aria-live="polite">{NOTICE_SUBSCRIBE_HINT}</p>
      </form>
    </div>
    <div class="cloth-canvas" data-cloth-canvas aria-hidden="true"></div>
  </div>
  <noscript>
    <style is:inline>
      .cloth-stage .cloth-fallback {
        inset: 7% 12% auto !important;
        min-height: 84% !important;
        padding: 32px !important;
        display: flex !important;
        background: #fff8e9 !important;
        pointer-events: auto !important;
      }
      .cloth-stage .cloth-copy {
        position: static !important;
        clip-path: none !important;
        width: auto !important;
        height: auto !important;
        overflow: visible !important;
      }
      .cloth-stage .cloth-field {
        position: static !important;
        opacity: 1 !important;
        visibility: visible !important;
        width: min(100%, 420px) !important;
        height: auto !important;
        grid-template-columns: 1fr auto !important;
        gap: 10px !important;
      }
      .cloth-stage .cloth-field p {
        position: static !important;
        clip-path: none !important;
        width: auto !important;
        height: auto !important;
      }
    </style>
  </noscript>
</section>

<!--
  The bundled script below cannot report its own failed or stalled download,
  so this inline script reveals the announcement instead. Script load errors
  do not bubble; only a capturing listener sees them. A stalled download
  fires nothing, so the message also appears if the cloth has not started
  after 20 s — long after a slow but working connection would have finished.
  If the cloth arrives later, mounting it takes over from the flat message.
-->
<script is:inline>
  {
    const reveal = (status, detail) => {
      const stage = document.querySelector("[data-cloth-stage]");
      const current = stage?.dataset.clothStatus;
      if (!stage || (current && current !== "script-stalled")) return;
      stage.classList.add("is-unavailable");
      stage.dataset.clothStatus = status;
      stage.dataset.clothDetail = detail;
    };
    document.addEventListener(
      "error",
      (event) => {
        const script = event.target;
        if (script instanceof HTMLScriptElement && script.type === "module")
          reveal("script-failed", script.src);
      },
      true,
    );
    setTimeout(
      () => reveal("script-stalled", "not started after 20 s"),
      20_000,
    );
  }
</script>

<script>
  import { mountClothNotice } from "@/lib/cloth/notice";
  import { enableClothDiagnostics } from "@/lib/cloth/diagnostics";
  import { enableSubscribeForm } from "@/lib/subscribe-form";

  const subscribe = document.querySelector<HTMLFormElement>("[data-subscribe]");
  if (subscribe) enableSubscribeForm(subscribe);

  const stage = document.querySelector<HTMLElement>("[data-cloth-stage]");
  if (stage) {
    enableClothDiagnostics(stage);
    let release: (() => void) | undefined;
    function mount() {
      if (!stage || release) return;
      stage.classList.remove("is-ready", "is-unavailable");
      stage.dataset.clothStatus = "starting";
      delete stage.dataset.clothDetail;
      try {
        release = mountClothNotice(stage);
      } catch (error) {
        stage.classList.add("is-unavailable");
        stage.dataset.clothStatus = "initialization-failed";
        stage.dataset.clothDetail ||= String(error);
        console.warn("Cloth animation unavailable:", error);
      }
    }
    window.addEventListener("pagehide", () => {
      release?.();
      release = undefined;
    });
    window.addEventListener("pageshow", (event) => {
      if (event.persisted) mount();
    });
    mount();
  }
</script>

<!--
  The sign-up's rules ship inline and unscoped: Astro only inlines a scoped
  stylesheet under 4 KB, and the notice must never fetch a separate one (see
  scripts/check-notice-build.ts). Class names here are unique to this page.
-->
<style is:inline>
  .cloth-field {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px;
    width: min(100%, 420px);
    margin-top: 22px;
  }
  .cloth-field label,
  .cloth-field .trap {
    position: absolute;
    width: 1px;
    height: 1px;
    clip-path: inset(50%);
    overflow: hidden;
  }
  .cloth-field input,
  .cloth-field button {
    min-width: 0;
    margin: 0;
    font:
      17px/1.3 "Baskerville",
      Georgia,
      serif;
  }
  .cloth-field input {
    padding: 10px 14px;
    color: #48201e;
    background: #f6ebd6;
    border: 2px dashed #8f5147;
    border-radius: 0;
  }
  .cloth-field button {
    padding: 10px 18px;
    color: #fff8e9;
    background: #8f5147;
    border: 0;
    outline: 2px dashed #fff8e9aa;
    outline-offset: -6px;
    cursor: pointer;
  }
  .cloth-field[data-state="done"] button {
    background: #5f7a58;
  }
  .cloth-field p {
    grid-column: 1 / -1;
    margin: 2px 0 0;
    font-size: 15px;
    font-style: italic;
    color: #8f5147;
  }
  .cloth-field[data-state="error"] p {
    color: #a3392f;
  }
  .cloth-stage:not(.is-unavailable) .cloth-field p {
    position: absolute;
    width: 1px;
    height: 1px;
    clip-path: inset(50%);
    overflow: hidden;
  }
  .cloth-stage:not(.is-unavailable) .cloth-field {
    position: absolute;
    z-index: 1;
    left: var(--field-x, 0);
    top: var(--field-y, 0);
    width: var(--field-w, 0);
    height: var(--field-h, 0);
    margin: 0;
    gap: 0;
    grid-template-columns: 31fr 1fr 13fr;
    opacity: 0;
    pointer-events: auto;
    /* Android paints its tap flash even over an invisible control. */
    -webkit-tap-highlight-color: transparent;
  }
  .cloth-stage:not(.is-unavailable) .cloth-field input {
    grid-column: 1;
    height: 100%;
    /* At least 16px, or iOS zooms the page when the field is focused. */
    font-size: 16px;
  }
  .cloth-stage:not(.is-unavailable) .cloth-field button {
    grid-column: 3;
    height: 100%;
  }
  .cloth-stage:not(.is-ready):not(.is-unavailable) .cloth-field,
  .cloth-stage:not(.is-unavailable) .cloth-field[data-folded] {
    visibility: hidden;
  }
</style>

<style>
  .cloth-notice {
    max-width: 1080px;
    margin: 0 auto;
    padding: 30px 24px;
  }
  .cloth-stage {
    position: relative;
    height: clamp(440px, 68svh, 680px);
    margin: 0 -20px;
  }
  .cloth-canvas {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .cloth-canvas :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
  }
  .cloth-fallback {
    position: absolute;
    inset: 7% 12% auto;
    min-height: 84%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 32px;
    text-align: center;
    color: #48201e;
    background: #fff8e9;
    box-shadow: 0 20px 35px #4d352318;
  }
  .cloth-copy h1 {
    max-width: 510px;
    font:
      48px/1.08 "Baskerville",
      Georgia,
      serif;
  }
  .cloth-copy hr {
    width: 48px;
    margin: 28px 0;
    border: 0;
    border-top: 1px solid #8f5147;
  }
  .cloth-copy p {
    max-width: 340px;
    font:
      19px/1.6 "Baskerville",
      Georgia,
      serif;
  }
  .cloth-copy .aside {
    margin-top: 18px;
    font-size: 16px;
    font-style: italic;
    color: #8f5147;
  }
  .cloth-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .cloth-stage.is-unavailable .cloth-canvas {
    visibility: hidden;
  }
  .cloth-stage.is-ready .cloth-canvas {
    opacity: 1;
  }
  /*
   * While the cloth draws the notice, the flat card dissolves: its words stay
   * for screen readers only, and the form becomes an invisible hit target
   * that field.ts keeps over the printed field. The grid mirrors the print's
   * 620 : 20 : 260 split between the input and the button.
   */
  .cloth-stage:not(.is-unavailable) .cloth-fallback {
    inset: 0;
    padding: 0;
    background: none;
    box-shadow: none;
    pointer-events: none;
  }
  .cloth-stage:not(.is-unavailable) .cloth-copy {
    position: absolute;
    width: 1px;
    height: 1px;
    clip-path: inset(50%);
    overflow: hidden;
  }
  @media (max-width: 600px) {
    .cloth-notice {
      padding: 24px 20px;
    }
    .cloth-stage {
      height: 430px;
    }
    .cloth-fallback {
      inset: 4% 5% auto;
      min-height: 92%;
      padding: 22px;
    }
    .cloth-copy h1 {
      font-size: 34px;
    }
  }
</style>
