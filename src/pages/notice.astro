---
import RsvpCloth from "@/components/RsvpCloth.astro";
import { NOTICE_ONLY } from "../../site.config";
import { RSVP_CLOSED_TITLE, RSVP_CLOSED_DETAILS } from "@/lib/rsvp-status";

if (!NOTICE_ONLY) return Astro.redirect("/");
const description = `${RSVP_CLOSED_TITLE} ${RSVP_CLOSED_DETAILS}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Jacob &amp; Vicki</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="Jacob & Vicki" />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <picture class="notice-background" aria-hidden="true">
      <source
        media="(max-width: 600px)"
        srcset="/notice-background-mobile.webp"
      />
      <img
        src="/notice-background-desktop.webp"
        alt=""
        fetchpriority="low"
        decoding="async"
      />
    </picture>
    <main><RsvpCloth /></main>
  </body>
</html>

<style>
  :global(html) {
    background: #211a15;
  }
  :global(body) {
    margin: 0;
    min-height: 100svh;
    overflow: hidden;
  }
  :global(*) {
    box-sizing: border-box;
  }
  .notice-background {
    position: fixed;
    inset: 0;
    pointer-events: none;
  }
  .notice-background img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  main {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  main :global(.cloth-notice) {
    width: 100%;
  }
  @media (max-height: 600px) {
    :global(body) {
      overflow-y: auto;
    }
  }
</style>
