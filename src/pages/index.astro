---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import HomeNav from "@/components/HomeNav.astro";
import SiteFooter from "@/components/SiteFooter.astro";

// The home page is now a signpost: hero, then the four links. Each section it
// used to stack inline lives at its own route under `src/pages/`.
---

<Layout>
  <main class="min-h-screen overflow-x-hidden bg-[#f4eadc] text-[#221812]">
    <Hero />

    <HomeNav />

    <SiteFooter />
  </main>
</Layout>
