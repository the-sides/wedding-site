---
import type { Post } from "@/lib/notion";
import PageLayout from "@/layouts/PageLayout.astro";
import Posts from "@/components/Posts.astro";
import ComingSoon from "@/components/ComingSoon.astro";
import { getPosts } from "@/lib/notion";

// Runs at build time. A Notion outage or missing credentials degrades to the
// empty state below rather than failing the build.
let posts: Array<Post> = [];

try {
  posts = await getPosts();
} catch (error) {
  console.error("Failed to fetch wedding posts:", error);
}
---

<PageLayout
  title="Extras"
  eyebrow="Notes"
  description="Updates and extra details for Jacob and Vicki's wedding."
>
  {
    posts.length > 0 ? (
      <Posts posts={posts} />
    ) : (
      <ComingSoon
        heading="Nothing yet"
        note="No updates posted so far. Anything worth knowing before the day will show up here."
      />
    )
  }
</PageLayout>
