# Notion Integration
# Create an integration at https://www.notion.so/my-integrations
NOTION_API_KEY=secret_xxx

# Database ID from the wedding posts database URL
NOTION_DATABASE_ID=xxx

# Data Source ID from the wedding posts database
# In API v2025-09-03, databases have a data_source_id for queries.
# This is not the same as the `v=` view ID in the Notion URL.
NOTION_DATA_SOURCE_ID=xxx

# Data Source ID for the RSVP Submissions database
# A different database from the posts one above, and the only one the public
# RSVP form writes to. Without it every submission fails with a 502.
NOTION_RSVP_DATA_SOURCE_ID=xxx

# Vercel Deploy Hook URL for triggering rebuilds
# Create at: Vercel Dashboard → Project Settings → Git → Deploy Hooks
VERCEL_DEPLOY_HOOK=https://api.vercel.com/v1/integrations/deploy/prj_xxx/yyy
